{
  "name": "fivem-ts",
  "author": {
    "name": "Overextended",
    "url": "https://overextended.dev"
  },
  "version": "0.0.0",
  "license": "",
  "description": "",
  "repository": {
    "type": "git",
    "url": "https://github.com/overextended/fivem-ts"
  },
  "bugs": "https://github.com/overextended/fivem-ts/issues",
  "keywords": [
    "fivem",
    "overextended"
  ],
  "private": true,
  "type": "module",
  "scripts": {
    "init": "bun run scripts/init.ts",
    "lint": "oxlint",
    "format": "oxfmt",
    "tsd": "bun tsdown --",
    "dev": "bun tsdown --watch & bun webbuild --watch",
    "webdev": "bun --cwd web vite dev --outDir ../dist/web --emptyOutDir",
    "webbuild": "bun --cwd web vite build --outDir ../dist/web --emptyOutDir",
    "build": "bun tsd & bun webbuild"
  },
  "devDependencies": {
    "@citizenfx/client": "latest",
    "@citizenfx/server": "latest",
    "@types/bun": "latest",
    "@types/node": "^22.13.10",
    "fast-glob": "^3.3.3",
    "oxfmt": "^0.51.0",
    "oxlint": "^1.66.0",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22.9.10"
  },
  "dependencies": {
    "@overextended/core": "^0.2.5",
    "@overextended/ox_lib": "^3.35.0"
  }
}